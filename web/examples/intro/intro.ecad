th": 1, "style": 1, "type": "path", "elements": [["M", -57.599999999999994, -9.599999999999994], ["C", -64, -9.599999999999994, -67.2, -6.399999999999996, -67.2, 0], ["C", -67.2, 6.400000000000006, -64, 9.600000000000009, -57.599999999999994, 9.600000000000009]], "sym_name": "회의실 예약 안내에 쓸 회의 탁자", "uid": "imvrhf1bk240r0tnp"}, {"pos": [2077.6, 1011.2], "scale": 2.2, "rotation": 0, "z": 12, "origin": [0, 0], "locked": false, "group_id": "gimvrhf1bj1wu1h7wn", "layer_id": null, "pen": "#ff1f1f1f", "width": 1, "style": 1, "type": "path", "elements": [["M", 57.599999999999994, -9.599999999999994], ["C", 64.00000000000001, -9.599999999999994, 67.20000000000002, -6.399999999999996, 67.20000000000002, 0], ["C", 67.20000000000002, 6.400000000000006, 64.00000000000001, 9.600000000000009, 57.599999999999994, 9.600000000000009]], "sym_name": "회의실 예약 안내에 쓸 회의 탁자", "uid": "imvrhf1bk25uj1e76"}, {"pos": [1244.0, 936.0], "scale": 1, "rotation": 0, "z": 13, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "image", "rect": [0, 0, 680, 453.3333333333333], "data": "", "alt": "직원 송년회 안내문에 넣을 따뜻한 분위기의 그림 그려 줘 (글자 없이)", "uid": "imvrhg41526s8lqtw"}, {"pos": [3087.2, 0], "scale": 1, "rotation": 0, "z": -1, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "frame", "rect": [0, 0, 1600, 2054.6000000000004], "name": "Deep Mode — 점심 30분 걷기, 몸에 무엇이 달라지나", "no": 5, "deep_plan": {"topic": "직장인 점심시간 30분 걷기의 건강 효과", "brief": {"누구에게": "알아서", "무엇에": "알아서", "깊이": "알아서", "꼭 넣을 것": ["숫자·그래프"], "재료": "알아서"}, "plan": {"title": "점심 30분 걷기, 몸에 무엇이 달라지나", "headline": "점심시간 30분 걷기, 앉아 일하는 직장인의 몸을 바꾼다", "sections": [{"title": "점심 30분 걷기가 몸에 남기는 변화", "question": "점심시간에 30분 걸으면 내 건강에 실제로 어떤 효과가 있나?", "shape": "주인공 글", "chart": null, "source": "web", "query": "점심시간 30분 걷기 건강 효과 연구 혈당 혈압 심혈관 직장인", "size": "주인공", "body": {"text": ["점심 뒤 걷기는 **식후 혈당이 치솟는 것을 줄이는 데** 도움이 돼요. 점심 전후에 20~30분 가벼운 걷기 같은 짧은 운동을 했을 때, 식후 혈당 상승이 가장 잘 낮아졌어요 [1].", "걷기는 **혈압도 조금 낮춰요.** 걷기는 모두 앉아 있는 것보다 수축기 혈압(위쪽 혈압)을 4~5mmHg 낮췄어요. 가장 좋은 조합은 30분마다 5분 걷기였어요 [3]. 30분마다 끊어 걸으면 혈당 반응도 눈에 띄게 누그러졌어요 [2].", "핵심은 **앉아 있는 시간을 자주 끊는 것**이에요. 30분 안쪽 간격으로 끊을수록 혈당 감소에 더 유리하다는 메타분석 결과도 있어요 [4]. 점심 걷기는 그 끊어 주는 시간 가운데 가장 챙기기 쉬운 한 번이에요."]}}, {"title": "한눈에 보기", "question": "이 판 전체를 그림 한 장으로 보면?", "shape": "요약 그림", "chart": null, "source": "ai", "query": null, "size": "보통", "body": {"img": "/api/img/intro/1793153921370_6df2fa.jpg", "w": 1536, "h": 1024, "model": "gpt-image-2.5-flare"}}, {"title": "기억할 숫자 3개", "question": "걷기 효과를 한눈에 보여 주는 핵심 숫자는 무엇인가?", "shape": "숫자 타일", "chart": null, "source": "web", "query": "하루 30분 걷기 사망 위험 감소율 식후 걷기 혈당 감소 연구 결과", "size": "보통", "body": {"tiles": [["최대 47%", "하루 30분 걷기와 연관된 사망 위험 감소 폭(기사 제목 기준)이에요.", 9], ["식후 10분씩", "당뇨병 환자는 하루 한 번 30분보다 매 식사 후 10분씩 나눠 걷는 편이 식후 혈당 관리에 더 효과적이었어요.", 11], ["20~30분", "점심 전후에 이 정도 가벼운 걷기를 하면 식후 혈당이 가장 잘 낮아졌어요.", 1]]}}, {"title": "걸음 수가 늘면 위험은 얼마나 줄까", "question": "하루 걸음 수에 따라 질병·사망 위험은 어떻게 달라지나?", "shape": "그래프", "chart": "꺾은선", "source": "web", "query": "하루 걸음 수별 사망 위험 감소 메타분석 연구 결과", "size": "보통", "body": {"rows": [["기준", "걸음 수(보, 각 범위의 낮은 쪽 값)"], ["효과 시작(2,500~3,000)", "2500 [18][21]"], ["60세 이상 뚜렷한 구간(6,000~8,000)", "6000 [20]"], ["권장 목표(7,000~8,000)", "7000 [17][20][19][21]"], ["60세 미만 뚜렷한 구간(8,000~10,000)", "8000 [20]"]], "header": true, "kind": "col", "caption": "걸음 수별 위험 수치는 재료에 없어, 효과가 보이는 걸음 수 기준만 비교했어요. 초반에 위험이 빨리 줄고 이후 완만해져요."}}, {"title": "우리나라 성인은 얼마나 움직이고 있나", "question": "한국 성인의 유산소 신체활동 실천율은 어떻게 변해 왔나?", "shape": "그래프", "chart": "꺾은선", "source": "kr", "query": "국민건강영양조사 성인 유산소 신체활동 실천율 연도별 통계", "size": "보통", "body": {"rows": [["연도", "유산소 신체활동 실천율(%, 19세 이상 표준화)"], ["2014", "58.3 [25]"], ["2015", "52.7 [25]"], ["2016", "49.4 [25]"], ["2017", "48.5 [25]"], ["2018", "47.6 [25]"], ["2019", "47.8 [25]"], ["2020", "45.6 [25]"], ["2021", "47.9 [25]"], ["2022", "53.1 [25]"], ["2023", "52.5 [25]"], ["2024", "52.1 [25]"]], "header": true, "kind": "line", "caption": "2014년 58.3%에서 2020년 45.6%까지 내려갔다가, 2022년 53.1%로 올라 2024년 52.1%예요 [25]."}}, {"title": "내 점심 걷기, 얼마나 태울까", "question": "체중과 걷는 속도를 바꾸면 30분 동안 쓰는 열량은 어떻게 달라지나?", "shape": "움직이는 카드", "chart": null, "source": "ai", "query": null, "size": "보통", "body": {"note": "체중과 걷는 속도를 바꾸면 30분 동안 쓰는 열량이 어떻게 달라지는지 바로 볼 수 있어요. 몸이 무거울수록, 빨리 걸을수록 열량이 늘어요.", "html": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>내 점심 걷기, 얼마나 태울까</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;height:100%;margin:0;overflow:hidden}\nbody{font-family:'Pretendard','Malgun Gothic',sans-serif;color:#18352e;background:#fff}\n.card{width:100vw;height:100vh;padding:22px 26px 16px;display:grid;grid-template-rows:auto minmax(0,1fr) auto auto auto;gap:12px;overflow:hidden}\nheader{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}\n.heading{min-width:0}\n.eyebrow{font-size:12px;color:#62776f;font-weight:700;margin-bottom:7px}\nh1{font-size:23px;letter-spacing:-1px;line-height:1.25;margin:0}\n.duration{font-size:12px;color:#61726b;margin-top:8px}\n.result{text-align:right;flex-shrink:0}\n.result-label{font-size:11px;color:#65776d;line-height:1.5}\n.energy{font-size:40px;line-height:1.1;font-weight:800;letter-spacing:-1.5px;color:#147b5b;white-space:nowrap}\n.energy small{font-size:15px;letter-spacing:0;margin-left:4px}\n.scene{position:relative;min-height:0;background:#f5f9f6;border-radius:18px;overflow:hidden}\nsvg{display:block;width:100%;height:100%}\n.scene-label{position:absolute;left:16px;top:12px;font-size:11px;color:#698174}\n.distance{position:absolute;right:16px;bottom:12px;font-size:12px;color:#35594a;background:#ffffffdc;padding:6px 9px;border-radius:8px}\n.controls{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n.control{padding:11px 14px 9px;background:#f5f7f6;border:1px solid #e2e9e5;border-radius:12px;min-width:0}\n.control-head{display:flex;align-items:baseline;justify-content:space-between;gap:6px;font-size:13px;font-weight:700}\noutput{white-space:nowrap;color:#147b5b;font-size:17px;font-variant-numeric:tabular-nums}\ninput[type=range]{display:block;width:100%;height:22px;margin:5px 0 0;accent-color:#168162;cursor:ew-resize}\ninput:focus-visible{outline:2px solid #14694f;outline-offset:3px;border-radius:6px}\n.notes{display:flex;flex-direction:column;gap:5px;min-width:0}\n.hint{font-size:12px;color:#34584a}\n.method{font-size:10px;line-height:1.4;color:#7a867f}\n.meaning{background:#eaf5ee;border-left:3px solid #218160;padding:10px 12px;font-size:13px;line-height:1.45;border-radius:0 8px 8px 0;word-break:keep-all}\n@media(max-width:520px){\n.card{padding:16px 14px 12px;gap:10px}\nh1{font-size:18px;letter-spacing:-.7px;max-width:210px}\n.energy{font-size:31px}\n.energy small{font-size:12px}\n.result-label{font-size:10px}\n.controls{gap:8px}\n.control{padding:9px 10px 7px}\n.control-head{font-size:12px}\noutput{font-size:15px}\n.meaning{font-size:12px;padding:8px 10px}\n.scene-label{font-size:10px;left:11px;top:10px}\n.distance{font-size:11px;right:10px;bottom:9px}\n}\n@media(max-height:390px){\n.card{padding:10px 16px;gap:6px}\nh1{font-size:18px}\n.eyebrow{margin-bottom:3px}\n.duration{margin-top:3px}\n.energy{font-size:30px}\n.control{padding:6px 10px}\n.meaning{padding:6px 10px;font-size:12px}\n.notes{gap:2px}\n}\n</style>\n</head>\n<body>\n<main class=\"card\">\n<header>\n<div class=\"heading\">\n<div class=\"eyebrow\" id=\"figure\"></div>\n<h1>내 점심 걷기,<br>얼마나 태울까</h1>\n<div class=\"duration\" id=\"duration\"></div>\n</div>\n<div class=\"result\" aria-live=\"polite\" aria-atomic=\"true\">\n<div class=\"result-label\">예시 값 · 총 소모 열량</div>\n<div class=\"energy\"><span id=\"energy\"></span><small>kcal</small></div>\n</div>\n</header>\n\n<div class=\"scene\">\n<div class=\"scene-label\">평지에서 같은 속도로 걸을 때</div>\n<svg viewBox=\"0 0 668 210\" role=\"img\" aria-labelledby=\"sceneTitle sceneDesc\">\n<title id=\"sceneTitle\">점심시간에 평지를 걷는 사람</title>\n<desc id=\"sceneDesc\"></desc>\n<path d=\"M0 157 Q90 140 171 154 T350 150 T540 155 T668 147 V210 H0Z\" fill=\"#e8f0e8\"/>\n<path d=\"M0 181 H668\" stroke=\"#c8d9ce\" stroke-width=\"2\"/>\n<path d=\"M0 191 H668\" stroke=\"#d9e4db\" stroke-width=\"1\"/>\n<g fill=\"#d6e6d8\">\n<path d=\"M77 157V105H82V157Z\"/>\n<ellipse cx=\"79\" cy=\"94\" rx=\"27\" ry=\"34\"/>\n<path d=\"M581 158V98H586V158Z\"/>\n<ellipse cx=\"583\" cy=\"83\" rx=\"32\" ry=\"39\"/>\n</g>\n<g stroke=\"#c5d8c8\" stroke-width=\"3\" stroke-linecap=\"round\">\n<path d=\"M107 168v-8m-4 5 4 3 4-5M543 169v-9m-4 5 4 3 4-5\"/>\n</g>\n<g id=\"footprints\" fill=\"#87b49b\" opacity=\".6\"></g>\n<ellipse id=\"shadow\" cx=\"264\" cy=\"183\" rx=\"54\" ry=\"5\" fill=\"#c7d9cb\"/>\n<g id=\"motion\" stroke=\"#93b9a4\" stroke-width=\"3\" stroke-linecap=\"round\"></g>\n<g>\n<path id=\"backArm\" fill=\"none\" stroke=\"#cf9a73\" stroke-width=\"10\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path id=\"backLeg\" fill=\"none\" stroke=\"#627b78\" stroke-width=\"15\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path id=\"backShoe\" fill=\"#344d49\"/>\n<path id=\"frontLeg\" fill=\"none\" stroke=\"#294c48\" stroke-width=\"16\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path id=\"frontShoe\" fill=\"#173c35\"/>\n<path d=\"M242 73 Q251 70 263 78 L274 128 Q253 138 235 128 L234 91Z\" fill=\"#18856a\"/>\n<path d=\"M241 76 Q231 78 229 95 L227 117\" fill=\"none\" stroke=\"#d5a45b\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n<path d=\"M232 88 Q220 82 215 95 L210 116 Q218 123 230 120Z\" fill=\"#e4ba76\"/>\n<path d=\"M248 66 L250 79\" stroke=\"#d4a17b\" stroke-width=\"12\" stroke-linecap=\"round\"/>\n<path d=\"M239 47 Q239 31 254 31 Q269 31 270 48 L275 53 270 57 Q269 70 257 70 Q242 68 240 57Z\" fill=\"#dba980\"/>\n<path d=\"M239 53 Q230 29 250 26 Q269 23 271 43 L254 40 247 50 245 57Z\" fill=\"#283e37\"/>\n<circle cx=\"266\" cy=\"48\" r=\"1.5\" fill=\"#34463c\"/>\n<path id=\"frontArm\" fill=\"none\" stroke=\"#e0ad84\" stroke-width=\"11\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path id=\"sleeve\" fill=\"none\" stroke=\"#13735b\" stroke-width=\"15\" stroke-linecap=\"round\"/>\n</g>\n</svg>\n<div class=\"distance\" id=\"distance\"></div>\n</div>\n\n<section class=\"controls\" aria-label=\"걷기 조건 바꾸기\">\n<div class=\"control\">\n<div class=\"control-head\"><label for=\"weight\">체중</label><output id=\"weightValue\" for=\"weight\"></output></div>\n<input id=\"weight\" type=\"range\" aria-label=\"체중\">\n</div>\n<div class=\"control\">\n<div class=\"control-head\"><label for=\"speed\">걷는 속도</label><output id=\"speedValue\" for=\"speed\"></output></div>\n<input id=\"speed\" type=\"range\" aria-label=\"걷는 속도\">\n</div>\n</section>\n<div class=\"notes\">\n<div class=\"hint\">막대를 움직여 체중과 속도를 바꿔 보세요.</div>\n<div class=\"method\">평지 걷기 산소소비 추정식 사용 · 쉬는 동안 쓰는 열량 포함 · 개인차 있음</div>\n</div>\n<div class=\"meaning\" id=\"meaning\" aria-live=\"polite\"></div>\n</main>\n\n<script>\nconst state = {\n  figure:1, minutes:30, source:1,\n  weight:70, speed:4.8,\n  weightMin:40, weightMax:110, weightStep:1,\n  speedMin:3, speedMax:6, speedStep:0.1,\n  oxygenRest:3.5, oxygenWalk:0.1, oxygenToEnergy:200,\n  minutesPerHour:60, metersPerKm:1000\n};\n\nfunction calculate(s) {\n  const velocity=s.speed*s.metersPerKm/s.minutesPerHour;\n  const kcal=(s.oxygenWalk*velocity+s.oxygenRest)*s.weight/s.oxygenToEnergy*s.minutes;\n  const distance=s.speed*s.minutes/s.minutesPerHour;\n  const stride=24+(s.speed-s.speedMin)/(s.speedMax-s.speedMin)*24;\n  const frontX=254+stride, backX=254-stride;\n  const footprints=Array.from({length:7},(_,i)=>{\n    const x=337+i*(18+stride*.24);\n    const y=170+(i%2)*7;\n    return `<ellipse cx=\"${x}\" cy=\"${y}\" rx=\"7\" ry=\"2.5\" transform=\"rotate(-12 ${x} ${y})\"/>`;\n  }).join('');\n  return {\n    figure:`그림 ${s.figure}`,\n    duration:`걷기 ${s.minutes}분 [${s.source}] · 체중·속도는 예시`,\n    energy:Math.round(kcal).toLocaleString('ko-KR'),\n    weight:`${s.weight} kg`,\n    speed:`${s.speed.toFixed(1)} km/h`,\n    distance:`걸은 거리 ${distance.toFixed(2)} km · 예시 값`,\n    meaning:`같은 ${s.minutes}분이라도 체중이 더 나가거나 더 빨리 걸으면, 쓰는 열량이 늘어요.`,\n    description:`체중 ${s.weight}킬로그램, 시속 ${s.speed.toFixed(1)}킬로미터로 ${s.minutes}분 걸을 때 약 ${Math.round(kcal)}킬로칼로리를 쓰는 예시입니다.`,\n    frontLeg:`M255 128 L${260+stride*.42} 155 L${frontX} 176`,\n    backLeg:`M250 128 L${243-stride*.24} 153 L${backX} 176`,\n    frontShoe:`M${frontX-7} 174 Q${frontX} 172 ${frontX+4} 176 L${frontX+17} 179 Q${frontX+20} 184 ${frontX+13} 184 H${frontX-9}Z`,\n    backShoe:`M${backX-6} 174 L${backX+5} 175 L${backX+15} 180 Q${backX+17} 184 ${backX+9} 184 H${backX-9}Z`,\n    backArm:`M243 85 L${227-stride*.15} 110 L${215-stride*.35} 103`,\n    frontArm:`M257 85 L${268+stride*.12} 109 L${283+stride*.4} 96`,\n    sleeve:`M257 85 L${263+stride*.08} 98`,\n    motion:`<path d=\"M${207-stride*.55} 72 H207 M${195-stride*.5} 92 H202 M${205-stride*.4} 111 H209\"/>`,\n    footprints,\n    shadowWidth:stride+18\n  };\n}\nconst el=id=>document.getElementById(id);\nfunction render(){\n  const v=calculate(state);\n  ['figure','duration','energy','distance','meaning'].forEach(id=>el(id).textContent=v[id]);\n  el('weightValue').textContent=v.weight;\n  el('speedValue').textContent=v.speed;\n  el('sceneDesc').textContent=v.description;\n  ['frontLeg','backLeg','frontShoe','backShoe','frontArm','backArm','sleeve'].forEach(id=>el(id).setAttribute('d',v[id]));\n  el('motion').innerHTML=v.motion;\n  el('footprints').innerHTML=v.footprints;\n  el('shadow').setAttribute('rx',v.shadowWidth);\n  ['weight','speed'].forEach(key=>{\n    const input=el(key);\n    input.min=state[key+'Min'];\n    input.max=state[key+'Max'];\n    input.step=state[key+'Step'];\n    input.value=state[key];\n    input.setAttribute('aria-valuetext',v[key]);\n  });\n}\n['weight','speed'].forEach(key=>el(key).addEventListener('input',event=>{\n  state[key]=Number(event.target.value);\n  render();\n}));\nrender();\n</script>\n</body>\n</html>", "card_model": "gpt-6.1-sol"}}, {"title": "점심 30분 걷기 실천 순서", "question": "점심시간 안에 밥도 먹고 걷기도 하려면 어떻게 하면 되나?", "shape": "단계 카드", "chart": null, "source": "ai", "query": null, "size": "작게", "body": {"steps": [["신발 챙기기", "편한 신발을 사무실에 두면 망설임이 줄어요."], ["식사 빨리 마치기", "밥은 20~30분 안에 먹고, 걷는 시간을 먼저 정해 두세요."], ["가볍게 시작", "처음 5분은 천천히 걸으며 몸을 풀어요."], ["속도 올리기", "말은 되지만 노래는 힘든 정도로 걸어요."], ["마무리", "마지막 5분은 속도를 줄이고 물을 마셔요."], ["쪼개도 괜찮아요", "30분이 어려우면 10분씩 나눠 걸어도 돼요."]]}}, {"title": "먹고 바로 걸어도 될까", "question": "식사 직후 걷기나 더운·추운 날 걷기에서 조심할 점은 무엇인가?", "shape": "접힌 메모", "chart": null, "source": "ai", "query": null, "size": "작게", "body": {"md": "- 식사 직후엔 천천히 걷기부터 시작하세요.\n- 배가 부를 때 뛰거나 급하게 걸으면 속이 불편할 수 있어요.\n- 옆구리가 아프거나 속이 쓰리면 속도를 늦추거나 잠시 쉬세요.\n- 더운 날엔 그늘길을 고르고 물을 챙기세요.\n- 추운 날엔 겹쳐 입고, 얼어붙은 길은 미끄러지지 않게 조심하세요.\n- 어지럽거나 가슴이 답답하면 바로 멈추고 쉬세요.\n- 혈압약이나 당뇨약을 먹고 있다면 의사와 운동 방법을 상의하세요."}}, {"title": "출처 카드", "question": "이 지면의 숫자와 연구 결과는 어디에서 왔나?", "shape": "출처 카드", "chart": null, "source": "ai", "query": null, "size": "작게", "body": {"links": [1, 2, 3, 4, 9, 11, 17, 18, 19, 20, 21, 25]}}], "sources": [{"n": 1, "title": "Type and timing of exercise during lunch breaks for suppressing postprandial increases in blood glucose levels in workers", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7893808/"}, {"n": 2, "title": "Breaking Up Prolonged Sitting to Improve Cardiometabolic Risk: Dose–Response Analysis of a Randomized Crossover Trial", "url": "https://doi.org/10.1249/mss.0000000000003109"}, {"n": 3, "title": "Rx for Prolonged Sitting: A Five-Minute Stroll Every Half Hour | Columbia University Irving Medical Center", "url": "https://www.cuimc.columbia.edu/news/rx-prolonged-sitting-five-minute-stroll-every-half-hour"}, {"n": 4, "title": "Optimal Frequency of Interrupting Prolonged Sitting for Cardiometabolic Health: A Systematic Review and Meta‐Analysis of Randomized Crossover Trials", "url": "https://doi.org/10.1111/sms.14769"}, {"n": 5, "title": "Type and timing of exercise during lunch breaks for suppressing postprandial increases in blood glucose levels in workers | Journal of Occupational Health | Oxford Academic", "url": "https://academic.oup.com/joh/article/63/1/e12199/7249859?login=false"}, {"n": 6, "title": "424_2019_2300_Article 1..10", "url": "https://link.springer.com/content/pdf/10.1007/s00424-019-02300-4.pdf?error=cookies_not_supported&code=4e7839f4-c2c8-4353-a75c-a274615e765e"}, {"n": 7, "title": "Impact of Prolonged Sitting Interruption on Blood Glucose, Insulin and Triacylglycerol in Adults: A Systematic Review and Meta-Analysis", "url": "https://www.mdpi.com/2076-3417/14/8/3201"}, {"n": 8, "title": "The Acute Effects of Interrupting Prolonged Sitting Time in Adults with Standing and Light-Intensity Walking on Biomarkers of Cardiometabolic Health in Adults: A Systematic Review and Meta-analysis", "url": "https://doi.org/10.1007/s40279-022-01649-4"}, {"n": 9, "title": "“돈 안 드는 최고의 약”…하루 30분 걷기, 사망 위험 최대 47% 낮춘다", "url": "https://n.news.naver.com/mnews/article/022/0004113637"}, {"n": 10, "title": "Daily Walking and Mortality in Racially and Socioeconomically Diverse U.S. Adults", "url": "http://www.echizenya-smc.com/info/wp-content/uploads/2025/08/PIIS0749379725002302.pdf"}, {"n": 11, "title": "Advice to walk after meals is more effective for lowering postprandial glycaemia in type 2 diabetes mellitus than advice that does not specify timing: a randomised crossover study", "url": "https://doi.org/10.1007/s00125-016-4085-2"}, {"n": 12, "title": "The Effects of Postprandial Walking on the Glucose Response after Meals with Different Characteristics", "url": "https://ncbi.nlm.nih.gov/pmc/articles/PMC8912639/"}, {"n": 13, "title": "Advice to walk after meals is more effective for lowering postprandial glycaemia in type 2 diabetes mellitus than advice that does not specify timing: a randomised crossover study", "url": "https://pubmed.ncbi.nlm.nih.gov/27747394/"}, {"n": 14, "title": "How does light-intensity physical activity associate with adult cardiometabolic health and mortality? Systematic review with meta-analysis of experimental and observational studies", "url": "https://doi.org/10.1136/bjsports-2017-097563"}, {"n": 15, "title": "Impact of Walking on Glycemic Control and Other Cardiovascular Risk Factors in Type 2 Diabetes: A Meta-Analysis", "url": "https://ncbi.nlm.nih.gov/pmc/articles/PMC4201471/"}, {"n": 16, "title": "How does light-intensity physical activity associate with adult cardiometabolic health and mortality? Systematic review with meta-analysis of experimental and observational studies", "url": "https://bjsm.bmj.com/content/bjsports/53/6/370.full.pdf"}, {"n": 17, "title": "Daily steps and health outcomes in adults: a systematic review and dose-response meta-analysis - The Lancet Public Health", "url": "https://www.thelancet.com/journals/lanpub/article/PIIS2468-2667(25)00164-1/fulltext"}, {"n": 18, "title": "Daily steps and all-cause mortality: An umbrella review and meta-analysis - ScienceDirect", "url": "https://www.sciencedirect.com/science/article/pii/S0091743524002020"}, {"n": 19, "title": "How many steps a day to reduce the risk of all‐cause mortality? A dose–response meta‐analysis - del Pozo Cruz - 2022 - Journal of Internal Medicine - Wiley Online Library", "url": "https://onlinelibrary.wiley.com/doi/10.1111/joim.13413"}, {"n": 20, "title": "Daily steps and all-cause mortality: a meta-analysis of 15 international cohorts", "url": "https://doi.org/10.1016/s2468-2667(21)00302-9"}, {"n": 21, "title": "Relationship of Daily Step Counts to All-Cause Mortality and Cardiovascular Events | JACC", "url": "https://www.jacc.org/doi/10.1016/j.jacc.2023.07.029"}, {"n": 22, "title": "The association between daily step count and all-cause and cardiovascular mortality: a meta-analysis", "url": "https://doi.org/10.1093/eurjpc/zwad229"}, {"n": 23, "title": "Dose-response association between the daily step count and all-cause mortality: A systematic review and meta-analysis", "url": "https://doi.org/10.1080/02640414.2022.2099186"}, {"n": 24, "title": "Meta-analysis of Per-Day Step Count and All-Cause Mortality", "url": "https://pubmed.ncbi.nlm.nih.gov/35961790/"}, {"n": 25, "title": "통계청 KOSIS", "url": "https://kosis.kr"}]}, "style": "calm", "fix": {}, "vs": {"0": "", "1": "", "2": "row", "3": "short", "4": "tall", "5": "", "6": "row", "7": "", "8": ""}, "sig": "1351054232"}, "uid": "imvrhkbdj8pse7d70"}, {"pos": [3135.2, 48], "scale": 1.4, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 1074.2857142857144, 97], "fill": "#00ffffff", "lines": [{"k": "p", "t": "점심 30분 걷기, 몸에 무엇이 달라지나 · 꼭지 9개", "runs": [[0, 30, "#71717a", false]]}, {"k": "h1", "t": "점심시간 30분 걷기, 앉아 일하는 직장인의 몸을 바꾼다"}], "pen": "#00ffffff", "deep_of": "imvrhkbdj8pse7d70", "uid": "imvrhkbdj8rx9gg3a"}, {"pos": [3135.2, 203.79999999999995], "scale": 1.2, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 1253.3333333333335, 147], "fill": "#ff27272a", "lines": [{"k": "h2", "t": "점심 30분 걷기가 몸에 남기는 변화", "runs": [[0, 20, "#ffffff", false]]}, {"k": "p", "t": "점심 뒤 걷기는 식후 혈당이 치솟는 것을 줄이는 데 도움이 돼요. 점심 전후에 20~30분 가벼운 걷기 같은 짧은 운동을 했을 때, 식후 혈당 상승이 가장 잘 낮아졌어요 [1].", "runs": [[0, 9, "#e4e4e7", false], [9, 19, "#ffffff", true], [28, 71, "#e4e4e7", false]]}, {"k": "p", "t": "걷기는 혈압도 조금 낮춰요. 걷기는 모두 앉아 있는 것보다 수축기 혈압(위쪽 혈압)을 4~5mmHg 낮췄어요. 가장 좋은 조합은 30분마다 5분 걷기였어요 [3]. 30분마다 끊어 걸으면 혈당 반응도 눈에 띄게 누그러졌어요 [2].", "runs": [[0, 4, "#e4e4e7", false], [4, 11, "#ffffff", true], [15, 114, "#e4e4e7", false]]}, {"k": "p", "t": "핵심은 앉아 있는 시간을 자주 끊는 것이에요. 30분 안쪽 간격으로 끊을수록 혈당 감소에 더 유리하다는 메타분석 결과도 있어요 [4]. 점심 걷기는 그 끊어 주는 시간 가운데 가장 챙기기 쉬운 한 번이에요.", "runs": [[0, 4, "#e4e4e7", false], [4, 17, "#ffffff", true], [21, 94, "#e4e4e7", false]]}], "pen": "#ff27272a", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 0, "uid": "imvrhkbdj8sjxbifc"}, {"pos": [3135.2, 396.2], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdk8vvdaygs", "layer_id": null, "type": "image", "rect": [0, 0, 744, 496], "data": "", "alt": "한눈에 보기 — Deep Mode 요약 그림", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 1, "uid": "imvrhkbdk8t1usify"}, {"pos": [3135.2, 896.2], "scale": 0.9, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdk8vvdaygs", "layer_id": null, "type": "memo", "rect": [0, 0, 826.6666666666666, 53], "fill": "#00ffffff", "lines": [{"k": "p", "t": "AI가 이 판 내용으로 그린 요약 그림 — 숫자의 출처는 각 꼭지에", "runs": [[0, 37, "#71717a", false]]}], "pen": "#00ffffff", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 1, "uid": "imvrhkbdk8uzsmsu2"}, {"pos": [3895.2, 396.2], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdk90l5c62e", "layer_id": null, "type": "memo", "rect": [0, 0, 744, 55], "fill": "#00ffffff", "lines": [{"k": "h3", "t": "기억할 숫자 3개"}], "pen": "#00ffffff", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 2, "uid": "imvrhkbdk8w2wsq0j"}, {"pos": [3895.2, 455.20000000000005], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdk90l5c62e", "layer_id": null, "type": "memo", "rect": [0, 0, 241.33333333333334, 138], "fill": "#ffffffff", "lines": [{"k": "h1", "t": "최대 47%", "runs": [[0, 6, "#b4532f", true]]}, {"k": "p", "t": "하루 30분 걷기와 연관된 사망 위험 감소 폭(기사 제목 기준)이에요."}, {"k": "p", "t": "[9] n.news.naver.com", "runs": [[0, 20, "#71717a", false]]}], "pen": "#ffda7756", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 2, "uid": "imvrhkbdk8xdldejh"}, {"pos": [4146.533333333333, 455.20000000000005], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdk90l5c62e", "layer_id": null, "type": "memo", "rect": [0, 0, 241.33333333333334, 171], "fill": "#ffffffff", "lines": [{"k": "h1", "t": "식후 10분씩", "runs": [[0, 7, "#b4532f", true]]}, {"k": "p", "t": "당뇨병 환자는 하루 한 번 30분보다 매 식사 후 10분씩 나눠 걷는 편이 식후 혈당 관리에 더 효과적이었어요."}, {"k": "p", "t": "[11] doi.org", "runs": [[0, 12, "#71717a", false]]}], "pen": "#ffda7756", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 2, "uid": "imvrhkbdk8yeodkj7"}, {"pos": [4397.866666666667, 455.20000000000005], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdk90l5c62e", "layer_id": null, "type": "memo", "rect": [0, 0, 241.33333333333334, 155], "fill": "#ffffffff", "lines": [{"k": "h1", "t": "20~30분", "runs": [[0, 6, "#b4532f", true]]}, {"k": "p", "t": "점심 전후에 이 정도 가벼운 걷기를 하면 식후 혈당이 가장 잘 낮아졌어요."}, {"k": "p", "t": "[1] pmc.ncbi.nlm.nih.gov", "runs": [[0, 24, "#71717a", false]]}], "pen": "#ffda7756", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 2, "uid": "imvrhkbdk8z1kjf43"}, {"pos": [3895.2, 642.2], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl94q2r7vt", "layer_id": null, "type": "memo", "rect": [0, 0, 744, 55], "fill": "#00ffffff", "lines": [{"k": "h3", "t": "걸음 수가 늘면 위험은 얼마나 줄까"}], "pen": "#00ffffff", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 3, "uid": "imvrhkbdk91dv1bmw"}, {"pos": [3895.2, 701.2], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl94q2r7vt", "layer_id": null, "type": "table", "rows": 5, "cols": 2, "header": true, "cells": [["기준", "걸음 수(보, 각 범위의 낮은 쪽 값)"], ["효과 시작(2,500~3,000)", "2500"], ["60세 이상 뚜렷한 구간(6,000~8,000)", "6000"], ["권장 목표(7,000~8,000)", "7000"], ["60세 미만 뚜렷한 구간(8,000~10,000)", "8000"]], "col_widths": [0.5, 0.5], "rect": [0, 0, 744, 200], "chart": "col", "table_wh": [744, 130], "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 3, "uid": "imvrhkbdk92sdg6ac"}, {"pos": [3895.2, 903.2], "scale": 0.9, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl94q2r7vt", "layer_id": null, "type": "memo", "rect": [0, 0, 826.6666666666666, 83], "fill": "#00ffffff", "lines": [{"k": "p", "t": "걸음 수별 위험 수치는 재료에 없어, 효과가 보이는 걸음 수 기준만 비교했어요. 초반에 위험이 빨리 줄고 이후 완만해져요.", "runs": [[0, 68, "#71717a", false]]}, {"k": "p", "t": "[17] thelancet.com · [18] sciencedirect.com · [19] onlinelibrary.wiley.com 외 2", "runs": [[0, 78, "#71717a", false]]}], "pen": "#00ffffff", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 3, "uid": "imvrhkbdk93jugb1m"}, {"pos": [3135.2, 993.9000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl98km9a17", "layer_id": null, "type": "memo", "rect": [0, 0, 744, 55], "fill": "#00ffffff", "lines": [{"k": "h3", "t": "우리나라 성인은 얼마나 움직이고 있나"}], "pen": "#00ffffff", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 4, "uid": "imvrhkbdl95llhmy2"}, {"pos": [3135.2, 1052.9], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl98km9a17", "layer_id": null, "type": "table", "rows": 12, "cols": 2, "header": true, "cells": [["연도", "유산소 신체활동 실천율(%, 19세 이상 표준화)"], ["2014", "58.3"], ["2015", "52.7"], ["2016", "49.4"], ["2017", "48.5"], ["2018", "47.6"], ["2019", "47.8"], ["2020", "45.6"], ["2021", "47.9"], ["2022", "53.1"], ["2023", "52.5"], ["2024", "52.1"]], "col_widths": [0.5, 0.5], "rect": [0, 0, 744, 260], "chart": "line", "table_wh": [744, 312], "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 4, "uid": "imvrhkbdl96ggpxdb"}, {"pos": [3135.2, 1314.9], "scale": 0.9, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl98km9a17", "layer_id": null, "type": "memo", "rect": [0, 0, 826.6666666666666, 83], "fill": "#00ffffff", "lines": [{"k": "p", "t": "2014년 58.3%에서 2020년 45.6%까지 내려갔다가, 2022년 53.1%로 올라 2024년 52.1%예요 [25].", "runs": [[0, 70, "#71717a", false]]}, {"k": "p", "t": "[25] kosis.kr", "runs": [[0, 13, "#71717a", false]]}], "pen": "#00ffffff", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 4, "uid": "imvrhkbdl976edzt5"}, {"pos": [3895.2, 993.9000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9bz8orxp", "layer_id": null, "type": "doc", "live": true, "rect": [0, 0, 744, 536], "title": "내 점심 걷기, 얼마나 태울까", "html": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>내 점심 걷기, 얼마나 태울까</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;height:100%;margin:0;overflow:hidden}\nbody{font-family:'Pretendard','Malgun Gothic',sans-serif;color:#18352e;background:#fff}\n.card{width:100vw;height:100vh;padding:22px 26px 16px;display:grid;grid-template-rows:auto minmax(0,1fr) auto auto auto;gap:12px;overflow:hidden}\nheader{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}\n.heading{min-width:0}\n.eyebrow{font-size:12px;color:#62776f;font-weight:700;margin-bottom:7px}\nh1{font-size:23px;letter-spacing:-1px;line-height:1.25;margin:0}\n.duration{font-size:12px;color:#61726b;margin-top:8px}\n.result{text-align:right;flex-shrink:0}\n.result-label{font-size:11px;color:#65776d;line-height:1.5}\n.energy{font-size:40px;line-height:1.1;font-weight:800;letter-spacing:-1.5px;color:#147b5b;white-space:nowrap}\n.energy small{font-size:15px;letter-spacing:0;margin-left:4px}\n.scene{position:relative;min-height:0;background:#f5f9f6;border-radius:18px;overflow:hidden}\nsvg{display:block;width:100%;height:100%}\n.scene-label{position:absolute;left:16px;top:12px;font-size:11px;color:#698174}\n.distance{position:absolute;right:16px;bottom:12px;font-size:12px;color:#35594a;background:#ffffffdc;padding:6px 9px;border-radius:8px}\n.controls{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n.control{padding:11px 14px 9px;background:#f5f7f6;border:1px solid #e2e9e5;border-radius:12px;min-width:0}\n.control-head{display:flex;align-items:baseline;justify-content:space-between;gap:6px;font-size:13px;font-weight:700}\noutput{white-space:nowrap;color:#147b5b;font-size:17px;font-variant-numeric:tabular-nums}\ninput[type=range]{display:block;width:100%;height:22px;margin:5px 0 0;accent-color:#168162;cursor:ew-resize}\ninput:focus-visible{outline:2px solid #14694f;outline-offset:3px;border-radius:6px}\n.notes{display:flex;flex-direction:column;gap:5px;min-width:0}\n.hint{font-size:12px;color:#34584a}\n.method{font-size:10px;line-height:1.4;color:#7a867f}\n.meaning{background:#eaf5ee;border-left:3px solid #218160;padding:10px 12px;font-size:13px;line-height:1.45;border-radius:0 8px 8px 0;word-break:keep-all}\n@media(max-width:520px){\n.card{padding:16px 14px 12px;gap:10px}\nh1{font-size:18px;letter-spacing:-.7px;max-width:210px}\n.energy{font-size:31px}\n.energy small{font-size:12px}\n.result-label{font-size:10px}\n.controls{gap:8px}\n.control{padding:9px 10px 7px}\n.control-head{font-size:12px}\noutput{font-size:15px}\n.meaning{font-size:12px;padding:8px 10px}\n.scene-label{font-size:10px;left:11px;top:10px}\n.distance{font-size:11px;right:10px;bottom:9px}\n}\n@media(max-height:390px){\n.card{padding:10px 16px;gap:6px}\nh1{font-size:18px}\n.eyebrow{margin-bottom:3px}\n.duration{margin-top:3px}\n.energy{font-size:30px}\n.control{padding:6px 10px}\n.meaning{padding:6px 10px;font-size:12px}\n.notes{gap:2px}\n}\n</style>\n</head>\n<body>\n<main class=\"card\">\n<header>\n<div class=\"heading\">\n<div class=\"eyebrow\" id=\"figure\"></div>\n<h1>내 점심 걷기,<br>얼마나 태울까</h1>\n<div class=\"duration\" id=\"duration\"></div>\n</div>\n<div class=\"result\" aria-live=\"polite\" aria-atomic=\"true\">\n<div class=\"result-label\">예시 값 · 총 소모 열량</div>\n<div class=\"energy\"><span id=\"energy\"></span><small>kcal</small></div>\n</div>\n</header>\n\n<div class=\"scene\">\n<div class=\"scene-label\">평지에서 같은 속도로 걸을 때</div>\n<svg viewBox=\"0 0 668 210\" role=\"img\" aria-labelledby=\"sceneTitle sceneDesc\">\n<title id=\"sceneTitle\">점심시간에 평지를 걷는 사람</title>\n<desc id=\"sceneDesc\"></desc>\n<path d=\"M0 157 Q90 140 171 154 T350 150 T540 155 T668 147 V210 H0Z\" fill=\"#e8f0e8\"/>\n<path d=\"M0 181 H668\" stroke=\"#c8d9ce\" stroke-width=\"2\"/>\n<path d=\"M0 191 H668\" stroke=\"#d9e4db\" stroke-width=\"1\"/>\n<g fill=\"#d6e6d8\">\n<path d=\"M77 157V105H82V157Z\"/>\n<ellipse cx=\"79\" cy=\"94\" rx=\"27\" ry=\"34\"/>\n<path d=\"M581 158V98H586V158Z\"/>\n<ellipse cx=\"583\" cy=\"83\" rx=\"32\" ry=\"39\"/>\n</g>\n<g stroke=\"#c5d8c8\" stroke-width=\"3\" stroke-linecap=\"round\">\n<path d=\"M107 168v-8m-4 5 4 3 4-5M543 169v-9m-4 5 4 3 4-5\"/>\n</g>\n<g id=\"footprints\" fill=\"#87b49b\" opacity=\".6\"></g>\n<ellipse id=\"shadow\" cx=\"264\" cy=\"183\" rx=\"54\" ry=\"5\" fill=\"#c7d9cb\"/>\n<g id=\"motion\" stroke=\"#93b9a4\" stroke-width=\"3\" stroke-linecap=\"round\"></g>\n<g>\n<path id=\"backArm\" fill=\"none\" stroke=\"#cf9a73\" stroke-width=\"10\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path id=\"backLeg\" fill=\"none\" stroke=\"#627b78\" stroke-width=\"15\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path id=\"backShoe\" fill=\"#344d49\"/>\n<path id=\"frontLeg\" fill=\"none\" stroke=\"#294c48\" stroke-width=\"16\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path id=\"frontShoe\" fill=\"#173c35\"/>\n<path d=\"M242 73 Q251 70 263 78 L274 128 Q253 138 235 128 L234 91Z\" fill=\"#18856a\"/>\n<path d=\"M241 76 Q231 78 229 95 L227 117\" fill=\"none\" stroke=\"#d5a45b\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n<path d=\"M232 88 Q220 82 215 95 L210 116 Q218 123 230 120Z\" fill=\"#e4ba76\"/>\n<path d=\"M248 66 L250 79\" stroke=\"#d4a17b\" stroke-width=\"12\" stroke-linecap=\"round\"/>\n<path d=\"M239 47 Q239 31 254 31 Q269 31 270 48 L275 53 270 57 Q269 70 257 70 Q242 68 240 57Z\" fill=\"#dba980\"/>\n<path d=\"M239 53 Q230 29 250 26 Q269 23 271 43 L254 40 247 50 245 57Z\" fill=\"#283e37\"/>\n<circle cx=\"266\" cy=\"48\" r=\"1.5\" fill=\"#34463c\"/>\n<path id=\"frontArm\" fill=\"none\" stroke=\"#e0ad84\" stroke-width=\"11\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path id=\"sleeve\" fill=\"none\" stroke=\"#13735b\" stroke-width=\"15\" stroke-linecap=\"round\"/>\n</g>\n</svg>\n<div class=\"distance\" id=\"distance\"></div>\n</div>\n\n<section class=\"controls\" aria-label=\"걷기 조건 바꾸기\">\n<div class=\"control\">\n<div class=\"control-head\"><label for=\"weight\">체중</label><output id=\"weightValue\" for=\"weight\"></output></div>\n<input id=\"weight\" type=\"range\" aria-label=\"체중\">\n</div>\n<div class=\"control\">\n<div class=\"control-head\"><label for=\"speed\">걷는 속도</label><output id=\"speedValue\" for=\"speed\"></output></div>\n<input id=\"speed\" type=\"range\" aria-label=\"걷는 속도\">\n</div>\n</section>\n<div class=\"notes\">\n<div class=\"hint\">막대를 움직여 체중과 속도를 바꿔 보세요.</div>\n<div class=\"method\">평지 걷기 산소소비 추정식 사용 · 쉬는 동안 쓰는 열량 포함 · 개인차 있음</div>\n</div>\n<div class=\"meaning\" id=\"meaning\" aria-live=\"polite\"></div>\n</main>\n\n<script>\nconst state = {\n  figure:1, minutes:30, source:1,\n  weight:70, speed:4.8,\n  weightMin:40, weightMax:110, weightStep:1,\n  speedMin:3, speedMax:6, speedStep:0.1,\n  oxygenRest:3.5, oxygenWalk:0.1, oxygenToEnergy:200,\n  minutesPerHour:60, metersPerKm:1000\n};\n\nfunction calculate(s) {\n  const velocity=s.speed*s.metersPerKm/s.minutesPerHour;\n  const kcal=(s.oxygenWalk*velocity+s.oxygenRest)*s.weight/s.oxygenToEnergy*s.minutes;\n  const distance=s.speed*s.minutes/s.minutesPerHour;\n  const stride=24+(s.speed-s.speedMin)/(s.speedMax-s.speedMin)*24;\n  const frontX=254+stride, backX=254-stride;\n  const footprints=Array.from({length:7},(_,i)=>{\n    const x=337+i*(18+stride*.24);\n    const y=170+(i%2)*7;\n    return `<ellipse cx=\"${x}\" cy=\"${y}\" rx=\"7\" ry=\"2.5\" transform=\"rotate(-12 ${x} ${y})\"/>`;\n  }).join('');\n  return {\n    figure:`그림 ${s.figure}`,\n    duration:`걷기 ${s.minutes}분 [${s.source}] · 체중·속도는 예시`,\n    energy:Math.round(kcal).toLocaleString('ko-KR'),\n    weight:`${s.weight} kg`,\n    speed:`${s.speed.toFixed(1)} km/h`,\n    distance:`걸은 거리 ${distance.toFixed(2)} km · 예시 값`,\n    meaning:`같은 ${s.minutes}분이라도 체중이 더 나가거나 더 빨리 걸으면, 쓰는 열량이 늘어요.`,\n    description:`체중 ${s.weight}킬로그램, 시속 ${s.speed.toFixed(1)}킬로미터로 ${s.minutes}분 걸을 때 약 ${Math.round(kcal)}킬로칼로리를 쓰는 예시입니다.`,\n    frontLeg:`M255 128 L${260+stride*.42} 155 L${frontX} 176`,\n    backLeg:`M250 128 L${243-stride*.24} 153 L${backX} 176`,\n    frontShoe:`M${frontX-7} 174 Q${frontX} 172 ${frontX+4} 176 L${frontX+17} 179 Q${frontX+20} 184 ${frontX+13} 184 H${frontX-9}Z`,\n    backShoe:`M${backX-6} 174 L${backX+5} 175 L${backX+15} 180 Q${backX+17} 184 ${backX+9} 184 H${backX-9}Z`,\n    backArm:`M243 85 L${227-stride*.15} 110 L${215-stride*.35} 103`,\n    frontArm:`M257 85 L${268+stride*.12} 109 L${283+stride*.4} 96`,\n    sleeve:`M257 85 L${263+stride*.08} 98`,\n    motion:`<path d=\"M${207-stride*.55} 72 H207 M${195-stride*.5} 92 H202 M${205-stride*.4} 111 H209\"/>`,\n    footprints,\n    shadowWidth:stride+18\n  };\n}\nconst el=id=>document.getElementById(id);\nfunction render(){\n  const v=calculate(state);\n  ['figure','duration','energy','distance','meaning'].forEach(id=>el(id).textContent=v[id]);\n  el('weightValue').textContent=v.weight;\n  el('speedValue').textContent=v.speed;\n  el('sceneDesc').textContent=v.description;\n  ['frontLeg','backLeg','frontShoe','backShoe','frontArm','backArm','sleeve'].forEach(id=>el(id).setAttribute('d',v[id]));\n  el('motion').innerHTML=v.motion;\n  el('footprints').innerHTML=v.footprints;\n  el('shadow').setAttribute('rx',v.shadowWidth);\n  ['weight','speed'].forEach(key=>{\n    const input=el(key);\n    input.min=state[key+'Min'];\n    input.max=state[key+'Max'];\n    input.step=state[key+'Step'];\n    input.value=state[key];\n    input.setAttribute('aria-valuetext',v[key]);\n  });\n}\n['weight','speed'].forEach(key=>el(key).addEventListener('input',event=>{\n  state[key]=Number(event.target.value);\n  render();\n}));\nrender();\n</script>\n</body>\n</html>", "model": "gpt-6.1-sol", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 5, "uid": "imvrhkbdl99qnhdzp"}, {"pos": [3895.2, 1533.9], "scale": 0.9, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9bz8orxp", "layer_id": null, "type": "memo", "rect": [0, 0, 826.6666666666666, 53], "fill": "#00ffffff", "lines": [{"k": "p", "t": "체중과 걷는 속도를 바꾸면 30분 동안 쓰는 열량이 어떻게 달라지는지 바로 볼 수 있어요. 몸이 무거울수록, 빨리 걸을수록 열량이 늘어요.", "runs": [[0, 77, "#71717a", false]]}], "pen": "#00ffffff", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 5, "uid": "imvrhkbdl9aeqims2"}, {"pos": [3135.2, 1597.6000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "memo", "rect": [0, 0, 1504, 55], "fill": "#00ffffff", "lines": [{"k": "h3", "t": "점심 30분 걷기 실천 순서"}], "pen": "#00ffffff", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdl9c3hh9qz"}, {"pos": [3135.2, 1656.6000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "memo", "rect": [0, 0, 225.66666666666666, 101], "fill": "#fffffaf7", "lines": [{"k": "h3", "t": "1. 신발 챙기기", "runs": [[0, 2, "#b4532f", true]]}, {"k": "p", "t": "편한 신발을 사무실에 두면 망설임이 줄어요."}], "pen": "#fff0c9b8", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdl9deskru4"}, {"pos": [3390.866666666667, 1656.6000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "memo", "rect": [0, 0, 225.66666666666666, 101], "fill": "#fffffaf7", "lines": [{"k": "h3", "t": "2. 식사 빨리 마치기", "runs": [[0, 2, "#b4532f", true]]}, {"k": "p", "t": "밥은 20~30분 안에 먹고, 걷는 시간을 먼저 정해 두세요."}], "pen": "#fff0c9b8", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdl9eh6lsli"}, {"pos": [3646.533333333333, 1656.6000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "memo", "rect": [0, 0, 225.66666666666666, 101], "fill": "#fffffaf7", "lines": [{"k": "h3", "t": "3. 가볍게 시작", "runs": [[0, 2, "#b4532f", true]]}, {"k": "p", "t": "처음 5분은 천천히 걸으며 몸을 풀어요."}], "pen": "#fff0c9b8", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdl9fb0mckd"}, {"pos": [3902.2, 1656.6000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "memo", "rect": [0, 0, 225.66666666666666, 101], "fill": "#fffffaf7", "lines": [{"k": "h3", "t": "4. 속도 올리기", "runs": [[0, 2, "#b4532f", true]]}, {"k": "p", "t": "말은 되지만 노래는 힘든 정도로 걸어요."}], "pen": "#fff0c9b8", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdl9gnfvb0c"}, {"pos": [4157.866666666667, 1656.6000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "memo", "rect": [0, 0, 225.66666666666666, 101], "fill": "#fffffaf7", "lines": [{"k": "h3", "t": "5. 마무리", "runs": [[0, 2, "#b4532f", true]]}, {"k": "p", "t": "마지막 5분은 속도를 줄이고 물을 마셔요."}], "pen": "#fff0c9b8", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdl9hev8i5z"}, {"pos": [4413.533333333333, 1656.6000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "memo", "rect": [0, 0, 225.66666666666666, 101], "fill": "#fffffaf7", "lines": [{"k": "h3", "t": "6. 쪼개도 괜찮아요", "runs": [[0, 2, "#b4532f", true]]}, {"k": "p", "t": "30분이 어려우면 10분씩 나눠 걸어도 돼요."}], "pen": "#fff0c9b8", "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdl9i9qgv6d"}, {"pos": [3135.2, 1773.6000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 490.6666666666667, 233], "fill": "#ffffffff", "lines": [{"k": "h3", "t": "먹고 바로 걸어도 될까"}, {"k": "ul", "t": "식사 직후엔 천천히 걷기부터 시작하세요."}, {"k": "ul", "t": "배가 부를 때 뛰거나 급하게 걸으면 속이 불편할 수 있어요."}, {"k": "ul", "t": "옆구리가 아프거나 속이 쓰리면 속도를 늦추거나 잠시 쉬세요."}, {"k": "ul", "t": "더운 날엔 그늘길을 고르고 물을 챙기세요."}, {"k": "ul", "t": "추운 날엔 겹쳐 입고, 얼어붙은 길은 미끄러지지 않게 조심하세요."}, {"k": "ul", "t": "어지럽거나 가슴이 답답하면 바로 멈추고 쉬세요."}, {"k": "ul", "t": "혈압약이나 당뇨약을 먹고 있다면 의사와 운동 방법을 상의하세요."}], "fold": true, "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 7, "uid": "imvrhkbdl9k6ul3li"}, {"pos": [3641.866666666667, 1773.6000000000001], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 997.3333333333334, 233], "fill": "#ffffffff", "lines": [{"k": "h3", "t": "출처 카드"}, {"k": "p", "t": "[25] 통계청 KOSIS", "runs": [[0, 4, null, true]]}, {"k": "p", "t": "https://kosis.kr", "runs": [[0, 16, "#71717a", false]]}, {"k": "p", "t": "[20] Daily steps and all-cause mortality: a meta-analysis of 15 international cohorts", "runs": [[0, 4, null, true]]}, {"k": "p", "t": "https://doi.org/10.1016/s2468-2667(21)00302-9", "runs": [[0, 45, "#71717a", false]]}, {"k": "p", "t": "[1] Type and timing of exercise during lunch breaks for suppressing postprandial increases in blood glucose levels in workers", "runs": [[0, 3, null, true]]}, {"k": "p", "t": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7893808/", "runs": [[0, 49, "#71717a", false]]}, {"k": "p", "t": "[21] Relationship of Daily Step Counts to All-Cause Mortality and Cardiovascular Events | JACC", "runs": [[0, 4, null, true]]}, {"k": "p", "t": "https://www.jacc.org/doi/10.1016/j.jacc.2023.07.029", "runs": [[0, 51, "#71717a", false]]}, {"k": "p", "t": "[2] Breaking Up Prolonged Sitting to Improve Cardiometabolic Risk: Dose–Response Analysis of a Randomized Crossover Trial", "runs": [[0, 3, null, true]]}, {"k": "p", "t": "https://doi.org/10.1249/mss.0000000000003109", "runs": [[0, 44, "#71717a", false]]}, {"k": "p", "t": "[3] Rx for Prolonged Sitting: A Five-Minute Stroll Every Half Hour | Columbia University Irving Medical Center", "runs": [[0, 3, null, true]]}, {"k": "p", "t": "https://www.cuimc.columbia.edu/news/rx-prolonged-sitting-five-minute-stroll-every-half-hour", "runs": [[0, 91, "#71717a", false]]}, {"k": "p", "t": "[4] Optimal Frequency of Interrupting Prolonged Sitting for Cardiometabolic Health: A Systematic Review and Meta‐Analysis of Randomized Crossover Trials", "runs": [[0, 3, null, true]]}, {"k": "p", "t": "https://doi.org/10.1111/sms.14769", "runs": [[0, 33, "#71717a", false]]}, {"k": "p", "t": "[9] “돈 안 드는 최고의 약”…하루 30분 걷기, 사망 위험 최대 47% 낮춘다", "runs": [[0, 3, null, true]]}, {"k": "p", "t": "https://n.news.naver.com/mnews/article/022/0004113637", "runs": [[0, 53, "#71717a", false]]}, {"k": "p", "t": "[11] Advice to walk after meals is more effective for lowering postprandial glycaemia in type 2 diabetes mellitus than advice that does not specify timing: a randomised crossover study", "runs": [[0, 4, null, true]]}, {"k": "p", "t": "https://doi.org/10.1007/s00125-016-4085-2", "runs": [[0, 41, "#71717a", false]]}, {"k": "p", "t": "[17] Daily steps and health outcomes in adults: a systematic review and dose-response meta-analysis - The Lancet Public Health", "runs": [[0, 4, null, true]]}, {"k": "p", "t": "https://www.thelancet.com/journals/lanpub/article/PIIS2468-2667(25)00164-1/fulltext", "runs": [[0, 83, "#71717a", false]]}, {"k": "p", "t": "[18] Daily steps and all-cause mortality: An umbrella review and meta-analysis - ScienceDirect", "runs": [[0, 4, null, true]]}, {"k": "p", "t": "https://www.sciencedirect.com/science/article/pii/S0091743524002020", "runs": [[0, 67, "#71717a", false]]}, {"k": "p", "t": "[19] How many steps a day to reduce the risk of all‐cause mortality? A dose–response meta‐analysis - del Pozo Cruz - 2022 - Journal of Internal Medicine - Wiley Online Library", "runs": [[0, 4, null, true]]}, {"k": "p", "t": "https://onlinelibrary.wiley.com/doi/10.1111/joim.13413", "runs": [[0, 54, "#71717a", false]]}], "fold": true, "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 8, "uid": "imvrhkbdp9lkex6qa"}, {"pos": [0, 0], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "sarrow", "routing": "ortho", "route_hints": [], "color": "#ffc4613f", "style": 1, "width": 1.5, "head": true, "head_start": false, "head_scale": 1, "curve_r": 10, "auto_route": true, "pts": [[3360.866666666667, 1707.1000000000001], [3376.8666666666663, 1707.1000000000001], [3374.866666666667, 1707.1000000000001], [3390.866666666667, 1707.1000000000001]], "bind1_pt": [225.66666666666674, 50.5], "bind1_group": null, "bind2_pt": [0, 50.5], "bind2_group": null, "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdq9mlego5q", "bind1": 37, "bind2": 38}, {"pos": [0, 0], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "sarrow", "routing": "ortho", "route_hints": [], "color": "#ffc4613f", "style": 1, "width": 1.5, "head": true, "head_start": false, "head_scale": 1, "curve_r": 10, "auto_route": true, "pts": [[3616.5333333333338, 1707.1000000000001], [3632.533333333333, 1707.1000000000001], [3630.5333333333333, 1707.1000000000001], [3646.533333333333, 1707.1000000000001]], "bind1_pt": [225.66666666666674, 50.5], "bind1_group": null, "bind2_pt": [0, 50.5], "bind2_group": null, "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdq9nemy32h", "bind1": 38, "bind2": 39}, {"pos": [0, 0], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "sarrow", "routing": "ortho", "route_hints": [], "color": "#ffc4613f", "style": 1, "width": 1.5, "head": true, "head_start": false, "head_scale": 1, "curve_r": 10, "auto_route": true, "pts": [[3872.2, 1707.1000000000001], [3888.1999999999994, 1707.1000000000001], [3886.2, 1707.1000000000001], [3902.2, 1707.1000000000001]], "bind1_pt": [225.66666666666674, 50.5], "bind1_group": null, "bind2_pt": [0, 50.5], "bind2_group": null, "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdq9o481ceh", "bind1": 39, "bind2": 40}, {"pos": [0, 0], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "sarrow", "routing": "ortho", "route_hints": [], "color": "#ffc4613f", "style": 1, "width": 1.5, "head": true, "head_start": false, "head_scale": 1, "curve_r": 10, "auto_route": true, "pts": [[4127.866666666667, 1707.1000000000001], [4143.866666666667, 1707.1000000000001], [4141.866666666667, 1707.1000000000001], [4157.866666666667, 1707.1000000000001]], "bind1_pt": [225.66666666666652, 50.5], "bind1_group": null, "bind2_pt": [0, 50.5], "bind2_group": null, "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdr9psc8u1b", "bind1": 40, "bind2": 41}, {"pos": [0, 0], "scale": 1, "rotation": 0, "z": 14, "origin": [0, 0], "locked": false, "group_id": "gimvrhkbdl9jwcz7xd", "layer_id": null, "type": "sarrow", "routing": "ortho", "route_hints": [], "color": "#ffc4613f", "style": 1, "width": 1.5, "head": true, "head_start": false, "head_scale": 1, "curve_r": 10, "auto_route": true, "pts": [[4383.533333333333, 1707.1000000000001], [4399.533333333334, 1707.1000000000001], [4397.533333333333, 1707.1000000000001], [4413.533333333333, 1707.1000000000001]], "bind1_pt": [225.66666666666652, 50.5], "bind1_group": null, "bind2_pt": [0, 50.5], "bind2_group": null, "deep_of": "imvrhkbdj8pse7d70", "deep_sec": 6, "uid": "imvrhkbdr9qa6joy1", "bind1": 41, "bind2": 42}, {"pos": [48, 48], "scale": 1, "rotation": 0, "z": 2, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 560, 306], "fill": "#ffffffff", "lines": [{"k": "h1", "t": "Magic Board 둘러보기"}, {"k": "p", "t": "KAIROS에게 물은 것이 흘러가 버리지 않고 칠판에 쌓이고, 정리되고, 남에게 전해지는 웹 칠판이에요. 이 칠판의 모든 조각은 오른쪽 KAIROS 대화창에서 실제로 묻고 붙여서 만들었어요."}, {"k": "h3", "t": "이 칠판 둘러보는 법"}, {"k": "ol", "t": "☰ 메뉴 「프레임 목록」에서 장을 누르면 그 자리로 가요"}, {"k": "ol", "t": "위 띠 「▶ 발표로 보기」를 누르면 프레임 순서대로 한 장씩 넘겨 봐요"}, {"k": "ol", "t": "오른쪽 KAIROS 대화창에 이 칠판을 만든 질문이 그대로 남아 있어요"}, {"k": "ol", "t": "마음껏 고치고 지워 보세요 — 위 띠의 「↺ 처음 모습으로」로 언제든 되돌려요"}, {"k": "p", "t": "내 칠판은 왼쪽 위 칠판 이름 ▾의 「＋ 새 칠판」으로 만들어요", "runs": [[0, 35, "#71717a", false]]}], "uid": "s747d42811104"}, {"pos": [672, 118], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "rect", "rect": [0, 0, 150, 64], "pen": "#ff1e2b45", "width": 1.5, "fill": "#ffe7f0ff", "style": 1, "radius": 12, "label": {"text": "묻기", "color": "#ff1e2b45", "font": 18, "bg": null}, "uid": "s4eb829b47b8a"}, {"pos": [672, 192], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "text", "text": "KAIROS 대화창", "color": "#ff8a8f98", "font": 12, "bg": null, "uid": "s6ed418397fba"}, {"pos": [892, 118], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "rect", "rect": [0, 0, 150, 64], "pen": "#ff1e2b45", "width": 1.5, "fill": "#ffe9f7ef", "style": 1, "radius": 12, "label": {"text": "붙이기", "color": "#ff1e2b45", "font": 18, "bg": null}, "uid": "sd9e44979660f"}, {"pos": [892, 192], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "text", "text": "답을 칠판으로", "color": "#ff8a8f98", "font": 12, "bg": null, "uid": "s488f339542bd"}, {"pos": [1112, 118], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "rect", "rect": [0, 0, 150, 64], "pen": "#ff1e2b45", "width": 1.5, "fill": "#fffff4d6", "style": 1, "radius": 12, "label": {"text": "정리", "color": "#ff1e2b45", "font": 18, "bg": null}, "uid": "sd52ed634383c"}, {"pos": [1112, 192], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "text", "text": "표·그래프·Deep Mode", "color": "#ff8a8f98", "font": 12, "bg": null, "uid": "s31c5c6c48bb0"}, {"pos": [1332, 118], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "rect", "rect": [0, 0, 150, 64], "pen": "#ff1e2b45", "width": 1.5, "fill": "#fffbeee8", "style": 1, "radius": 12, "label": {"text": "공유", "color": "#ff1e2b45", "font": 18, "bg": null}, "uid": "s14d1bc7c7f4d"}, {"pos": [1332, 192], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "text", "text": "링크·QR·발표·PDF", "color": "#ff8a8f98", "font": 12, "bg": null, "uid": "s1b70f3e2c6f9"}, {"pos": [0, 0], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "sarrow", "routing": "ortho", "route_hints": [], "color": "#ff1e2b45", "style": 1, "width": 1.5, "head": true, "head_start": false, "head_scale": 1, "curve_r": 10, "auto_route": false, "pts": [[822, 150.0], [892, 150.0]], "bind1_pt": null, "bind1_group": null, "bind2_pt": null, "bind2_group": null, "bind1": null, "bind2": null, "labels": [], "uid": "s7094fd7545de"}, {"pos": [0, 0], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "sarrow", "routing": "ortho", "route_hints": [], "color": "#ff1e2b45", "style": 1, "width": 1.5, "head": true, "head_start": false, "head_scale": 1, "curve_r": 10, "auto_route": false, "pts": [[1042, 150.0], [1112, 150.0]], "bind1_pt": null, "bind1_group": null, "bind2_pt": null, "bind2_group": null, "bind1": null, "bind2": null, "labels": [], "uid": "s49debd02e693"}, {"pos": [0, 0], "scale": 1, "rotation": 0, "z": 3, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "sarrow", "routing": "ortho", "route_hints": [], "color": "#ff1e2b45", "style": 1, "width": 1.5, "head": true, "head_start": false, "head_scale": 1, "curve_r": 10, "auto_route": false, "pts": [[1262, 150.0], [1332, 150.0]], "bind1_pt": null, "bind1_group": null, "bind2_pt": null, "bind2_group": null, "bind1": null, "bind2": null, "labels": [], "uid": "sa767a4b2a26c"}, {"pos": [1698, 48], "scale": 1, "rotation": 0, "z": 2, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 750, 101], "fill": "#fff6f7f9", "lines": [{"k": "h3", "t": "이렇게 만들었어요"}, {"k": "p", "t": "대화창에 「2026년 연말정산에서 직장인이 챙겨야 할 달라진 점을 정리해 줘」라고 물었어요. 최신 정보는 KAIROS가 웹에서 찾아 답하고, 답 밑 「칠판에 붙이기」를 누르면 요약 메모와 출처 카드가 함께 붙어요. 카드를 누르면 그 페이지가 열려요."}], "uid": "sbcc074a32dd7"}, {"pos": [48, 787], "scale": 1, "rotation": 0, "z": 2, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 980, 114], "fill": "#fff6f7f9", "lines": [{"k": "h3", "t": "이렇게 만들었어요"}, {"k": "ul", "t": "「신입 직원 첫 주 적응 계획을 요일별 표로 짜 줘」 → 표가 든 메모가 붙어요. 칸을 눌러 바로 고쳐요."}, {"k": "ul", "t": "「최근 5년 우리나라 1인 가구 비율을 연도별 표로 알려 줘」 → 숫자 표 답 밑 「그래프로 › 꺾은선」. 그래프를 두 번 누르면 표로 펼쳐 숫자를 고쳐요."}], "uid": "s96110ed2a0d6"}, {"pos": [1244, 787], "scale": 1, "rotation": 0, "z": 2, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 939.2, 114], "fill": "#fff6f7f9", "lines": [{"k": "h3", "t": "이렇게 만들었어요"}, {"k": "ul", "t": "「직원 송년회 안내문에 넣을 따뜻한 분위기의 그림 그려 줘」 → 후보 2장 중 마음에 드는 것을 눌러 붙여요."}, {"k": "ul", "t": "「회의실 예약 안내에 쓸 회의 탁자 SVG 선 그림 그려 줘」 → 선 하나하나 고칠 수 있는 아이콘(오른쪽). 색·굵기도 칠판 펜으로 바꿔요."}], "uid": "se4614fc414a3"}, {"pos": [2399.2, 787], "scale": 1, "rotation": 0, "z": 2, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 520, 380], "fill": "#ffffffff", "lines": [{"k": "h3", "t": "회의"}, {"k": "p", "t": "도구 줄 ⋯ 「회의 받아 적기」 → 말하는 사람별로 받아 적고, 「끝내기」를 누르면 요약·결정·할 일이 프레임 하나로 정리돼요. 녹음 파일을 칠판에 끌어 놓아도 돼요."}, {"k": "h3", "t": "발표"}, {"k": "p", "t": "「발표」 → 프레임 순서대로 한 장씩. 펜으로 판서하고, 발표 중 Q를 누르면 이 칠판 QR이 크게 떠요."}, {"k": "h3", "t": "공유"}, {"k": "p", "t": "「공유」 → 이 주소를 보내면 같이 고쳐요. 게시 링크는 보기만, 「내보내기」는 PDF·이미지·HTML 한 파일."}, {"k": "h3", "t": "해 볼 일"}, {"k": "todo", "t": "이 칠판 둘러보기", "done": true}, {"k": "todo", "t": "대화창에 내 일 하나 물어보고 칠판에 붙이기"}, {"k": "todo", "t": "칠판 이름 ▾ 「＋ 새 칠판」으로 내 칠판 만들기"}], "uid": "sf6357acefc7b"}, {"pos": [0, 0], "scale": 1, "rotation": 0, "z": -1, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "frame", "rect": [0, 0, 1530, 398], "name": "Magic Board 둘러보기", "no": 1, "uid": "sfde9e5286c63"}, {"pos": [1650, 0], "scale": 1, "rotation": 0, "z": -1, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "frame", "rect": [0, 0, 846, 619], "name": "묻고 바로 칠판에", "no": 2, "uid": "s11303c3cea64"}, {"pos": [0, 739], "scale": 1, "rotation": 0, "z": -1, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "frame", "rect": [0, 0, 1076, 730], "name": "표·그래프로 정리", "no": 3, "uid": "sea1a9a071aa8"}, {"pos": [1196, 739], "scale": 1, "rotation": 0, "z": -1, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "frame", "rect": [0, 0, 1035.2, 698.3333333333333], "name": "그림·아이콘도 말로", "no": 4, "uid": "sd62d6bb891a7"}, {"pos": [2351.2, 739], "scale": 1, "rotation": 0, "z": -1, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "frame", "rect": [0, 0, 616, 455], "name": "회의·발표·공유", "no": 15, "uid": "s6ab0b148f1d8"}, {"pos": [1498.2, 1638], "scale": 1.4, "rotation": 0, "z": 19, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 380, 211], "fill": "#fff6f7f9", "lines": [{"k": "h3", "t": "이렇게 만들었어요"}, {"k": "ul", "t": "대화창에 「방송 송출 사고가 났을 때 발생부터 긴급 조치, 복구, 경위 보고까지 처리 흐름도 그려 줘 (주조정실·송신소·보도국·부서장)」라고만 했어요(20초쯤)."}, {"k": "ul", "t": "상자와 화살표가 따로따로예요 — 상자를 끌어 옮기면 화살표가 따라오고, 글은 두 번 눌러 고쳐요."}, {"k": "ul", "t": "「시청자 민원 접수 단계도 넣어 줘」처럼 이어 말하면 이 흐름도를 고쳐 줘요."}], "uid": "sb8d56a438aa6"}, {"pos": [0, 2700], "scale": 1, "rotation": 0, "z": 0, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "frame", "rect": [0, 0, 1600, 900], "name": "여러 장 발표 자료 · 작은 책", "no": 7, "uid": "s7f36bce2757e"}, {"pos": [100, 2800], "scale": 2, "rotation": 0, "z": 20, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "memo", "rect": [0, 0, 700, 253], "fill": "#fff6f7f9", "lines": [{"k": "h3", "t": "이렇게 만들었어요 — 오른쪽 프레임 6장"}, {"k": "ul", "t": "대화창 「+ › 📰 Deep Mode」에 주제 「뉴스 한 편이 방송되기까지 — 취재부터 송출까지」를 적고, 질문지 맨 위 「📖 여러 장」(5장 · 그림 장 반쯤 · 웹 검색)을 골랐어요."}, {"k": "ul", "t": "장 계획을 보고 「이대로 만들기」 → 1분쯤 뒤 글 장과 그림 장이 섞인 작은 책이 생겨요. 장 밑 회색 메모는 발표자 메모예요."}, {"k": "ul", "t": "「발표」로 한 장씩 넘기고, 「내보내기 › PDF」에서 용지 「프레임」을 고르면 여백 없이 책처럼 뽑혀요."}, {"k": "ul", "t": "💬 11번 장 그림의 맨 오른쪽 이름표가 「주조정실」로 두 번 나와서, 그림을 우클릭 → 「댓글…」에 「@KAIROS 맨 오른쪽 이름표만 「송신소」로 …」라고 했더니 그 자리에서 고쳐졌어요(18초). 그림 오른쪽 위 💬를 누르면 그 댓글이 보여요."}, {"k": "ul", "t": "동화처럼 같은 인물이 이어지는 책은 질문지 「내용 › 이야기」를 골라요."}], "uid": "s7b2fc69910ad"}, {"pos": [0.0, 1590.0], "scale": 1, "rotation": 0, "z": -4, "origin": [0, 0], "locked": false, "group_id": null, "layer_id": null, "type": "frame", "rect": [0, 0, 2070.2, 1060.8], "name": "방송 송출 사고 처리 흐름", "no": 6, "flow_spec": "{\n \"title\": \"방송 송출 사고 처리 흐름\",\n \"direction\": \"LR\",\n \"lanes\": [\"주조정실\", \"부서장\", \"송신소\", \"보도국\"],\n \"focus\": \"s8\",\n \"steps\": [\n  {\"id\": \"s1\", \"text\": \"송출 사고 발생·감지\", \"lane\": \"주조정실\", \"kind\": \"start\"},\n  {\"id\": \"s2\", \"text\": \"긴급 보고·조치 지휘\", \"lane\": \"부서장\"},\n  {\"id\": \"s3\", \"text\": \"원인 구간 확인\", \"lane\": \"주조정실\"},\n  {\"id\": \"s4\", \"text\": \"송신소 측 원인?\", \"lane\": \"주조정실\", \"kind\": \"decision\"},\n  {\"id\": \"s5\", \"text\": \"예비 송신기 전환\", \"lane\": \"송신소\"},\n  {\"id\": \"s6\", \"text\": \"예비 송출 계통 전환\", \"lane\": \"주조정실\"},\n  {\"id\": \"s7\", \"text\": \"시청자 안내 자막·공지\", \"lane\": \"보도국\"},\n  {\"id\": \"s8\", \"text\": \"송출 정상 복구?\", \"lane\": \"주조정실\", \"kind\": \"decision\"},\n  {\"id\": \"s9\", \"text\": \"복구 안내 방송\", \"lane\": \"보도국\"},\n  {\"id\": \"s10\", \"text\": \"사고 경위서 작성\", \"lane\": \"주조정실\", \"kind\": \"document\"},\n  {\"id\": \"s11\", \"text\": \"경위서 검토·승인\", \"lane\": \"부서장\", \"kind\": \"document\"},\n  {\"id\": \"s12\", \"text\": \"경위 보고 완료\", \"lane\": \"부서장\", \"kind\": \"end\"}\n ],\n \"links\": [\n  {\"from\": \"s1\", \"to\": \"s2\"},\n  {\"from\": \"s2\", \"to\": \"s3\"},\n  {\"from\": \"s2\", \"to\": \"s7\"},\n  {\"from\": \"s3\", \"to\": \"s4\"},\n  {\"from\": \"s4\", \"to\": \"s5\", \"text\": \"예\"},\n  {\"from\": \"s4\", \"to\": \"s6\", \"text\": \"아니오\"},\n  {\"from\": \"s5\", \"to\": \"s8\"},\n  {\"from\": \"s6\", \"to\": \"s8\"},\n  {\"from\": \"s8\", \"to\": \"s9\", \"text\": \"예\"},\n  {\"from\": \"s8\", \"to\": \"s3\", \"text\": \"아니오\"},\n  {\"from\": \"s7\", \"to\": \"s9\"},\n  {\"from\": \"s9\", \"to\": \"s10\"},\n  {\"from\": \"s10\", \"to\": \"s11\"},\n  {\"from\": \"s11\", \"to\": \"s12\"}\n ]\n}", "flow_sig": "[[\"path\",null,40,40,null,null,null,\"#1e4a8fd9\",\"#784a8fd9\",null],[\"text\",null,50,86,null,\"주조정실\",null,null,null,\"#ff4a8fd9\"],[\"path\",null,40,170,null,null,null,\"#1e3ea37a\",\"#783ea37a\",null],[\"text\",null,57,216,null,\"부서장\",null,null,null,\"#ff3ea37a\"],[\"path\",null,40,299,null,null,null,\"#1e8a6fd1\",\"#788a6fd1\",null],[\"text\",null,57,345,null,\"송신소\",null,null,null,\"#ff8a6fd1\"],[\"path\",null,40,429,null,null,null,\"#1ec9a227\",\"#78c9a227\",null],[\"text\",null,57,475,null,\"보도국\",null,null,null,\"#ffc9a227\"],[\"path\",null,40,642,null,null,null,\"#1e4a8fd9\",\"#784a8fd9\",null],[\"text\",null,50,688,null,\"주조정실\",null,null,null,\"#ff4a8fd9\"],[\"path\",null,40,772,null,null,null,\"#1e3ea37a\",\"#783ea37a\",null],[\"text\",null,57,818,null,\"부서장\",null,null,null,\"#ff3ea37a\"],[\"path\",null,40,901,null,null,null,\"#1ec9a227\",\"#78c9a227\",null],[\"text\",null,57,947,null,\"보도국\",null,null,null,\"#ffc9a227\"],[\"symbol\",\"terminal\",149,65,[0,0,174,70],null,\"송출 사고\\n발생·감지\",\"#ffd7e6f7\",\"#ff4a8fd9\",null],[\"rect\",null,395,194,[0,0,174,70],null,\"긴급\\n보고·조치 지휘\",\"#ffd5ebe2\",\"#ff3ea37a\",null],[\"rect\",null,642,65,[0,0,174,70],null,\"원인 구간 확인\",\"#ffd7e6f7\",\"#ff4a8fd9\",null],[\"symbol\",\"decision\",888,62,[0,0,240,76],null,\"송신소 측 원인?\",\"#ffd7e6f7\",\"#ff4a8fd9\",null],[\"rect\",null,1222,324,[0,0,174,70],null,