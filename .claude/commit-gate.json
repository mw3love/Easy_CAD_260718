{
  "rules": [
    {"name": "파이썬 시험", "paths": ["*.py", "tests/**", "easycad/**", "requirements.txt"], "run": "python -m pytest -q -x -p no:cacheprovider tests", "cwd": "."},
    {"name": "웹 시험", "paths": ["web/**"], "run": "npm test", "cwd": "web"},
    {"name": "디자인 검사", "paths": ["web/src/**", "easycad/**", ".claude/design-check.json", ".claude/design-baseline.json"], "run": "python ~/.claude/tools/design_check.py", "cwd": "."}
  ]
}
